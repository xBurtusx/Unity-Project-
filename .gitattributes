*.jpg  binary
*.jpeg binary
*.gif  binary
*.tga  binary
*.tif  binary
*.tiff binary
*.psd  binary
*.bmp  binary
*.exr  binary
*.hdr  binary
*.ico  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.dae  binary
*.3ds  binary
*.ma   binary
*.mb   binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.aif  binary
*.aiff binary
*.mp4  binary
*.mov  binary
*.webm binary
